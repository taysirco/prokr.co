# ══════════════════════════════════════════════
# Prokr.co — Root .gitignore
# ══════════════════════════════════════════════

# ── Dependencies ──
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js Build ──
/.next/
/out/
/build/

# ── Testing ──
/coverage/

# ── Environment & Secrets ──
.env*
serviceAccountKey.json
scripts/gcloud-key.json

# ── Firebase ──
firebase-debug.log*

# ── Vercel (legacy — migrated to Firebase App Hosting) ──
.vercel/

# ── OS junk ──
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor / IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Debug & temp scripts ──
consoleCheck.js
domCheck.js
omega_ignition.py
dev.log

# ── Data files (not needed for runtime) ──
*.xlsx
*.csv.bak
*.resolved

# ── Security keys ──
*.pem

# ── TypeScript cache ──
*.tsbuildinfo
next-env.d.ts

# ── Cloudflare Worker sub-project artifacts ──
cloudflare/*/node_modules/
cloudflare/*/.wrangler/
cloudflare/*/package-lock.json
cloudflare/*/.dev.vars
