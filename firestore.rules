rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Static data (cities, services) - public read
    match /static_data/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Advertisers - public read, authenticated write
    match /advertisers/{advertiserId} {
      // Anyone can read advertiser data
      allow read: if true;
      
      // Authenticated users can create (for admin dashboard)
      // In production, add more restrictions based on custom claims
      allow create: if request.auth != null;
      
      // Only document owner or admin can update/delete
      allow update, delete: if request.auth != null;
    }
    
    // Reviews - public read, authenticated write
    match /advertisers/{advertiserId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.user_id;
    }
    
    // Contact form submissions - anyone can create, only authenticated reads
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // Advertiser registration requests - anyone can create, authenticated manage
    match /advertiser_requests/{requestId} {
      // Anyone can create a registration request
      allow create: if true;
      
      // Only authenticated admin can read/update/delete
      allow read, update, delete: if request.auth != null;
    }
    
    // AI Booking API — service bookings from /api/book
    // Anyone (including AI agents) can create, admin manages
    match /service_bookings/{bookingId} {
      // API creates bookings (no auth required for AI agent access)
      allow create: if true
        && request.resource.data.keys().hasAll([
          'reservation_id', 'service_slug', 'city_slug',
          'customer_name', 'customer_phone', 'source', 'status'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.customer_name is string
        && request.resource.data.customer_phone is string;
      
      // Only authenticated admin can read/update/delete
      allow read, update, delete: if request.auth != null;
    }
    
    // Admin-only data
    match /admin/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Business Claims — claim verification for company ownership
    match /business_claims/{claimId} {
      // Anyone can read claim status (CTA checks if claimed)
      allow read: if true;
      // Anyone can create a new claim (email is sent for verification)
      allow create: if true;
      // Update allowed for verification flow (email/phone confirm)
      allow update: if true;
      // Only authenticated admin can delete
      allow delete: if request.auth != null;
    }
    
    // Verified Reviews — authenticated reviews for companies
    match /verified_reviews/{reviewId} {
      // Anyone can read reviews (public display)
      allow read: if true;
      // Anyone can create a review (auth gate is client-side + server validates token)
      allow create: if true;
      // Update for verification status changes
      allow update: if true;
      // Only authenticated admin can delete
      allow delete: if request.auth != null;
    }
  }
}
