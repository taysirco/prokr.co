rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════
    // ⚠️ DEPLOY PREREQUISITE — READ BEFORE `firebase deploy --only firestore:rules`
    // ────────────────────────────────────────────────────────────────
    // Privileged operations below now require a custom admin claim
    // (request.auth.token.admin == true) instead of "any signed-in user".
    // BEFORE deploying, grant that claim to your admin UID(s) with the Admin SDK
    // or the admin dashboard's client-SDK writes will stop working:
    //
    //   const admin = require('firebase-admin');
    //   admin.initializeApp({ credential: admin.credential.cert(require('./serviceAccountKey.json')) });
    //   await admin.auth().setCustomUserClaims('<ADMIN_UID>', { admin: true });
    //   // the admin must then sign out/in (or refresh the ID token).
    //
    // NOTE: every /api/* route uses the Firebase ADMIN SDK, which BYPASSES these
    // rules — so server-side booking/claim/review writes are unaffected by this.
    // Previously these rules treated ANY authenticated user as an admin (IDOR):
    // any signed-up user could delete advertisers and read all lead PII.
    // ════════════════════════════════════════════════════════════════
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }

    // Static data (cities, services) — public read, admin write
    match /static_data/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Advertisers — public read, admin-only write (was: any signed-in user)
    match /advertisers/{advertiserId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Reviews subcollection — public read; owner or admin can modify
    match /advertisers/{advertiserId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.user_id);
    }

    // Contact form submissions — anyone creates, ADMIN-only reads (contains lead PII)
    match /contact_submissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Advertiser registration requests — anyone creates, admin manages
    match /advertiser_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // AI Booking API — public create (AI agents / booking flow), admin manages.
    // Create validation kept intact; reads/mutations restricted to admin.
    match /service_bookings/{bookingId} {
      allow create: if true
        && request.resource.data.keys().hasAll([
          'reservation_id', 'service_slug', 'city_slug',
          'customer_name', 'customer_phone', 'source', 'status'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.customer_name is string
        && request.resource.data.customer_phone is string;
      allow read, update, delete: if isAdmin();
    }

    // Admin-only data
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // Business Claims — written ONLY via the Admin SDK (API routes, which bypass
    // these rules). Block ALL direct client-SDK writes so the API's validation /
    // token checks can't be bypassed by writing the doc directly from a browser.
    match /business_claims/{claimId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // Verified Reviews — same policy: server-only writes via Admin SDK.
    match /verified_reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
